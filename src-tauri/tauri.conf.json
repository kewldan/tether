{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "../package.json",
  "identifier": "dev.kewldan.tether",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tether",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A quiet, fast desktop GUI for Android Debug Bridge",
    "copyright": "\u00a9 2026 kewldan",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNTY5NjJCRjQwQkUwRjAKUldUdzRBdjBLNVpXR21uSzE3aklFRFBMOHpyUUdYT0kxdWdZV2l5WUFQRG03emlpTy9vMmZjTmgK",
      "endpoints": [
        "https://github.com/kewldan/tether/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
