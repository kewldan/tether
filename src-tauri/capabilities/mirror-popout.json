{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mirror-popout",
  "description": "Picture-in-picture windows of screen mirroring (one per device)",
  "windows": [
    "mirror-popout-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top"
  ]
}
